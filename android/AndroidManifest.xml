<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.j4niwzis.osu_cpp">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hasCode="@OSU_ANDROID_HAS_CODE@"
        android:icon="@drawable/osu_cpp_icon"
        android:label="osu!cpp"
        android:resizeableActivity="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <!-- No orientation is asked for here.

             The client draws in whatever the window is and arranges itself
             for it, so a window either way up is one it can use. Where a
             person wants one way up in particular, the setting says so and
             the client asks the system for it while it runs: a system that
             turns its screen then gives a window already the right way up
             and nothing is composed, and one that will not is answered by
             turning the buffer instead.

             Asked here, it would cost that turn to everyone whose display
             is set to turn only when a person turns it. Such a display
             answers the request by letterboxing: 1080x534 at the top of a
             1080x2340 screen, for a client that never wanted it. -->
        <activity
            android:name="@OSU_ANDROID_ACTIVITY@"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false">
            <meta-data
                android:name="android.app.lib_name"
                android:value="osu_client" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
